{
  "name": "@harness/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm && vite build client --emptyOutDir",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@harness/core": "*",
    "cors": "^2.8.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.0.0",
    "@types/express": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.1.4",
    "tsx": "^4.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
