{
  "name": "@harness/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:static-demo": "vite build client --outDir ../dist/static-demo --emptyOutDir",
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --clean && vite build client --emptyOutDir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@harness/core": "^0.1.0",
    "@napi-rs/keyring": "^1.3.0",
    "cors": "^2.8.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cors": "^2.0.0",
    "@types/express": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.1.4",
    "tsx": "^4.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
